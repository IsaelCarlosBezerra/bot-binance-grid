{
	"name": "bot-binance",
	"version": "1.0.0",
	"main": "dist/src/index.js",
	"type": "module",
	"scripts": {
		"dev": "tsx watch src/index.ts",
		"build": "tsc",
		"postinstall": "prisma generate",
		"start": "prisma migrate deploy && node dist/src/index.js",
		"test": "node --experimental-vm-modules node_modules/jest/bin/jest.js --coverage",
		"admin:create": "tsx scripts/create-admin.ts",
		"kill": "powershell -ExecutionPolicy Bypass -File scripts/kill-dev.ps1",
		"dev:all": "concurrently --kill-others --kill-others-on-fail --names \"API,UI\" --prefix-colors \"cyan,magenta\" \"npm run dev\" \"npm run dev --prefix src/ui/react\""
	},
	"keywords": [],
	"author": "",
	"license": "ISC",
	"description": "",
	"devDependencies": {
		"@types/bcryptjs": "^2.4.6",
		"@types/cors": "^2.8.19",
		"@types/express": "^5.0.6",
		"@types/jsonwebtoken": "^9.0.10",
		"@types/mssql": "^9.1.9",
		"@types/node": "^25.0.10",
		"concurrently": "^9.2.1",
		"jest": "^30.4.2",
		"prisma": "^6.19.2",
		"ts-jest": "^29.4.11",
		"ts-node": "^10.9.2",
		"tsx": "^4.21.0",
		"typescript": "^5.9.3"
	},
	"dependencies": {
		"@prisma/client": "^6.19.2",
		"@types/dotenv": "^6.1.1",
		"@types/jest": "^30.0.0",
		"bcryptjs": "^3.0.3",
		"cors": "^2.8.6",
		"dotenv": "^17.2.3",
		"express": "^5.2.1",
		"jsonwebtoken": "^9.0.3",
		"mssql": "^12.2.0",
		"node-binance-api": "^1.0.20"
	}
}
