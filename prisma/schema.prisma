// prisma/schema.prisma
generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id           String       @id @default(uuid())
  email        String       @unique @db.VarChar(255)
  passwordHash String       @db.VarChar(255)
  name         String       @db.VarChar(100)
  plan         Plan         @default(FREE)
  role         Role         @default(USER)
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt

  botInstance  BotInstance?

  @@map("users")
}

model BotInstance {
  id                     String   @id @default(uuid())
  userId                 String   @unique
  user                   User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  // Binance credentials (encrypted)
  binanceApiKey          String   @db.VarChar(512)
  binanceApiSecret       String   @db.VarChar(512)
  testnet                Boolean  @default(false)

  // Bot config
  symbol                 String   @default("BTCUSDT") @db.VarChar(20)
  enabled                Boolean  @default(false)
  cycleIntervalMs        Int      @default(5000)
  buyPercentageOfBalance Float    @default(0.1)
  targetNetProfit        Float    @default(0.005)
  grossTargetPercentage  Float    @default(0.008)
  dropPercentage         Float    @default(0.008)
  buyReferenceMode       String   @default("LAST_BUY") @db.VarChar(30)

  createdAt              DateTime @default(now())
  updatedAt              DateTime @updatedAt

  tradeOrders            TradeOrder[]

  @@map("bot_instances")
}

model TradeOrder {
  id                String      @id @default(uuid())
  botInstanceId     String
  botInstance       BotInstance @relation(fields: [botInstanceId], references: [id], onDelete: Cascade)

  symbol            String      @db.VarChar(20)
  buyPrice          Decimal     @db.Decimal(18, 8)
  quantity          Decimal     @db.Decimal(18, 8)
  sellPrice         Decimal?    @db.Decimal(18, 8)
  expectedNetProfit Decimal     @db.Decimal(18, 8)
  status            String      @default("OPEN") @db.VarChar(20)
  createdAt         BigInt

  @@map("trade_orders")
}

enum Plan {
  FREE
  PRO
}

enum Role {
  USER
  ADMIN
}
