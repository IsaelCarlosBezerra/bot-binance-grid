# ─── Banco de dados ───────────────────────────────────────────────────────────
# Railway fornece automaticamente quando você adiciona o plugin PostgreSQL
DATABASE_URL=postgresql://usuario:senha@host:5432/banco?schema=public

# ─── Segredos do servidor ─────────────────────────────────────────────────────
# Gere com: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=troque-por-um-segredo-longo-e-aleatorio
ENCRYPTION_SECRET=troque-por-outro-segredo-longo-e-aleatorio

# ─── CORS ─────────────────────────────────────────────────────────────────────
# URL do frontend na Vercel (sem barra no final)
# Para múltiplas origens separe com vírgula
CORS_ORIGIN=https://seu-app.vercel.app
